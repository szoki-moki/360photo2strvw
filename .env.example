# Host directory containing the JPEG photo spheres. Relative paths are resolved
# from the directory containing docker-compose.yml.
IMAGE_UPLOAD_HOST_DIR=./test_images

# Enable Street View Publish API in the same Google Cloud project. An API key
# alone cannot authorize uploads; the Desktop OAuth client below is also needed.
GOOGLE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional fallback for remote/headless environments. Normally the interactive
# browser flow creates and persists a refresh token automatically.
GOOGLE_REFRESH_TOKEN=

# Used when an EXIF date has no embedded UTC offset. It can also be changed from
# the application's menu for the current session.
EXIF_TIMEZONE=Europe/Budapest

# Must match the host/container port published by Docker Compose.
OAUTH_CALLBACK_PORT=8765

REQUEST_TIMEOUT_SECONDS=60
MAX_UPLOAD_ATTEMPTS=3

# On Linux, set these to the output of `id -u` and `id -g` so the non-root
# container user can move files in the bind-mounted image directory.
HOST_UID=1000
HOST_GID=1000
